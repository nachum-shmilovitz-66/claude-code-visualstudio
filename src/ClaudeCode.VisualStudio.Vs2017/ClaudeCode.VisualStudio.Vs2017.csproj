    <Compile Include="..\ClaudeCode.VisualStudio\AssemblyResolver.cs">
      <Link>AssemblyResolver.cs</Link>
    </Compile>
    <Compile Include="..\ClaudeCode.VisualStudio\Vsct\PackageGuids.cs">
