  <ItemGroup>
    <VSCTCompile Include="..\ClaudeCode.VisualStudio\VSCommandTable.vsct">
      <Link>VSCommandTable.vsct</Link>
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="15.9.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Community.VisualStudio.Toolkit.15" Version="15.0.551" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
  <!--
    VS 2017 only carries System.Text.Json 4.x — our 9.x closure must travel in the VSIX for the
    AssemblyResolver to serve. These are already in $(OutDir) via the package references.
  -->
  <Target Name="ForceJsonClosureIntoVsix" AfterTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Include="$(OutDir)System.Text.Json.dll" />
      <VSIXSourceItem Include="$(OutDir)System.Text.Encodings.Web.dll" />
      <VSIXSourceItem Include="$(OutDir)System.IO.Pipelines.dll" />
      <VSIXSourceItem Include="$(OutDir)System.Memory.dll" />
      <VSIXSourceItem Include="$(OutDir)System.Buffers.dll" />
      <VSIXSourceItem Include="$(OutDir)System.Runtime.CompilerServices.Unsafe.dll" />
      <VSIXSourceItem Include="$(OutDir)System.Threading.Tasks.Extensions.dll" />
      <VSIXSourceItem Include="$(OutDir)System.Numerics.Vectors.dll" />
      <VSIXSourceItem Include="$(OutDir)System.ValueTuple.dll" />
      <VSIXSourceItem Include="$(OutDir)Microsoft.Bcl.AsyncInterfaces.dll" />
    </ItemGroup>
  </Target>
  <!-- Publish the VSIX to the repo-root dist folder. Release builds only. -->
  <Target Name="CopyVsixToDist" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And Exists('$(TargetVsixContainer)')">
    <Copy SourceFiles="$(TargetVsixContainer)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\dist" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Copied VSIX -&gt; $(MSBuildProjectDirectory)\..\..\dist\$([System.IO.Path]::GetFileName($(TargetVsixContainer)))" />
  </Target>
</Project>
