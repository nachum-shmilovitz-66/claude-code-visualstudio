    <Compile Include="..\ClaudeCode.VisualStudio\Services\SlashCommandService.cs">
      <Link>Services\SlashCommandService.cs</Link>
    </Compile>
    <Compile Include="..\ClaudeCode.VisualStudio\Services\SlashCommandCache.cs">
