    </Compile>
    <Compile Include="..\ClaudeCode.VisualStudio\Services\IdeContextService.cs">
      <Link>Services\IdeContextService.cs</Link>
    </Compile>
    <Compile Include="..\ClaudeCode.VisualStudio\Services\DebugContextService.cs">
      <Link>Services\DebugContextService.cs</Link>
    </Compile>
    <Compile Include="..\ClaudeCode.VisualStudio\Services\ThemeService.cs">
      <Link>Services\ThemeService.cs</Link>
    </Compile>
    <Compile Include="..\ClaudeCode.VisualStudio\Services\AccountService.cs">
      <Link>Services\AccountService.cs</Link>
    </Compile>
    <Compile Include="..\ClaudeCode.VisualStudio\Services\UsageInsightsService.cs">
      <Link>Services\UsageInsightsService.cs</Link>
    </Compile>
    <Compile Include="..\ClaudeCode.VisualStudio\Services\McpService.cs">
      <Link>Services\McpService.cs</Link>
