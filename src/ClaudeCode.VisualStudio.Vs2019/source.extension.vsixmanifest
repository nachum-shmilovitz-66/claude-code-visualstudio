<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- Distinct Identity Id from the VS2022/2026 VSIX: the marketplace treats each Id as one
         extension with one VSIX, so the VS 2019 flavor ships as its own listing. -->
    <Identity Id="ClaudeCode.VisualStudio.Vs2019.15FC1958-19BD-4195-8BB9-AFD6DD0F334C" Version="0.2.28" Language="en-US" Publisher="Nachum Shmilovitz" />
    <DisplayName>Claude Code for Visual Studio 2019</DisplayName>
    <Description xml:space="preserve">Claude Code brings Anthropic's agentic coding assistant directly into Visual Studio 2019 — the same experience as the VS Code extension, docked next to Solution Explorer.

━━━ FEATURES ━━━

  •  Chat with Claude about your open solution — it reads and edits your code, runs tools, and shows results inline
  •  Activity timeline — every response shows each step (thinking, searches, file reads/edits) on a connected rail with status dots
  •  Runs in your open solution folder automatically — no extra configuration
  •  Pick the model, permission mode, and thinking effort right from the composer
  •  Live context-window usage ring, plus an account &amp; usage panel
  •  Slash commands, image attachments, and one-click compaction
  •  Edited files open automatically so you can review the diff

━━━ REQUIREMENTS ━━━

  •  Powered by the Claude Code CLI — sign in once by running 'claude' in a terminal
  •  Visual Studio 2019 (16.x) and the WebView2 Runtime (preinstalled on Windows 10/11)</Description>
    <MoreInfo>https://www.anthropic.com/claude-code</MoreInfo>
    <License>Resources\LICENSE.txt</License>
    <Icon>Resources\Icon.png</Icon>
    <PreviewImage>Resources\Preview.png</PreviewImage>
    <Tags>claude;claude code;ai;assistant;agent;chat;anthropic;copilot;llm;pair programming</Tags>
  </Metadata>
  <Installation>
    <!-- No ProductArchitecture element: VS 2019 is x86-only and its setup engine predates
         that element (introduced for VS 2022). -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[16.0,17.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[16.0,17.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[16.0,17.0)" />
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[16.0,17.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
