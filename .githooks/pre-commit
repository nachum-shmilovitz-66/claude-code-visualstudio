#!/bin/sh
#
# Keep the README version badge in sync with the VSIX manifest, so every
# commit (and therefore every push) carries the current version. This runs
# at commit time on purpose: a pre-push hook cannot alter the commit that is
# already being pushed.
#
# It only rewrites the text between the managed markers:
#   <!-- managed:version -->vX.Y.Z<!-- /managed:version -->
# so it can never touch unrelated prose. If README or the marker is missing,
# it is a no-op.

manifest="src/ClaudeCode.VisualStudio/source.extension.vsixmanifest"
readme="README.md"

[ -f "$manifest" ] || exit 0
[ -f "$readme" ] || exit 0

# <Identity ... Version="X.Y.Z" ...> -- not the PackageManifest version, not the GUID.
version=$(grep '<Identity' "$manifest" \
  | grep -o 'Version="[0-9][0-9.]*"' \
  | grep -o '[0-9][0-9.]*' | head -n1)

[ -n "$version" ] || exit 0

tmp=$(mktemp) || exit 0
sed -E "s#(<!-- managed:version -->)v?[0-9][0-9.]*(<!-- /managed:version -->)#\1v$version\2#" \
  "$readme" > "$tmp" && mv "$tmp" "$readme"

# Stage the README only if the sync actually changed it, so this never
# silently pulls in unrelated unstaged README edits.
if ! git diff --quiet -- "$readme"; then
  echo "pre-commit: synced README version badge -> v$version"
  git add "$readme"
fi

exit 0
